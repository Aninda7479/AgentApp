{
  "name": "@superagent/desktop",
  "version": "0.30.0",
  "description": "SuperAgent Desktop — Tauri v2 host shell. All UI is in @superagent/ui.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aninda7479/AgentApp.git",
    "directory": "packages/desktop"
  },
  "main": "dist/renderer/entry.bundle.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:ui": "npm run --workspace=@superagent/ui build",
    "watch:ui": "npm run --workspace=@superagent/ui dev",
    "dev": "npx @tauri-apps/cli dev",
    "build": "npx @tauri-apps/cli build",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri:build": "npx @tauri-apps/cli build",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run"
  },
  "dependencies": {
    "@superagent/ui": "file:../ui"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^20.14.9",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
