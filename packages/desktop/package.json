{
  "name": "@superagent/desktop",
  "version": "0.3.5",
  "description": "SuperAgent Desktop App — Powered by Tauri v2 and Rust Host",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aninda7479/AgentApp.git",
    "directory": "packages/desktop"
  },
  "main": "dist/renderer/entry.bundle.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:ui": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/ui.html','dist/ui.html');fs.copyFileSync('src/pet.html','dist/pet.html');fs.copyFileSync('src/circle-search.html','dist/circle-search.html');fs.copyFileSync('src/tray.html','dist/tray.html');fs.copyFileSync('src/overlay.html','dist/overlay.html');if(fs.existsSync('assets')){fs.mkdirSync('dist/assets',{recursive:true});fs.readdirSync('assets').forEach(f=>fs.copyFileSync(p.join('assets',f),p.join('dist/assets',f)));}\" && node scripts/bundle-renderer.mjs",
    "watch:ui": "npm run build:ui && node scripts/bundle-renderer.mjs --watch",
    "dev": "concurrently -n \"watch-ui,tauri\" -c \"cyan,magenta\" \"npm run watch:ui\" \"npx @tauri-apps/cli dev\"",
    "build": "npm run build:ui && npx @tauri-apps/cli build",
    "tauri:dev": "npm run dev",
    "tauri:build": "npx @tauri-apps/cli build",
    "test": "vitest run"
  },
  "dependencies": {
    "@superagent/core": "file:../core",
    "@superagent/ui": "file:../ui",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.2.1",
    "@huggingface/transformers": "^3.5.2",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.1",
    "three-vrm": "npm:@pixiv/three-vrm@^3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
