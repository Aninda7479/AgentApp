{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for SuperAgent Desktop app",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "updater:default",
    "process:allow-restart",
    "shell:default",
    "dialog:default",
    "notification:default"
  ]
}
