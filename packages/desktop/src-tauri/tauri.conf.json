{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperAgent",
  "version": "0.25.0",
  "identifier": "com.opensource.agentapp",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run --workspace=@superagent/ui dev",
    "beforeBuildCommand": "npm run --workspace=@superagent/ui build"
  },
  "app": {
    "windows": [
      {
        "title": "SuperAgent — Autonomous AI Agent",
        "url": "index.html",
        "width": 1280,
        "height": 830,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "label": "main",
        "center": true,
        "decorations": false
      },
      {
        "title": "SuperAgent Artifacts Card",
        "url": "tray.html",
        "width": 380,
        "height": 540,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "fullscreen": false,
        "label": "artifacts"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGN0JDMEUwNjI5NzNGNEUKUldST1A1ZGk0TUI3L3pBQnZWN1U0VjFzcXp6Y2YwTno1dHlqZVF3QkM0TnFGWC94Y0FiMnV0UjYK",
      "endpoints": [
        "https://github.com/Aninda7479/AgentApp/releases/latest/download/updater.json"
      ]
    }
  }
}
