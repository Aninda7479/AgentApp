{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperAgent",
  "version": "0.1.0",
  "identifier": "com.opensource.agentapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:14692",
    "beforeDevCommand": "npm run build:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "title": "SuperAgent — Autonomous AI Agent",
        "width": 1280,
        "height": 830,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMzcxMjM0NWFiY2RlZg==",
      "endpoints": [
        "https://github.com/Aninda7479/AgentApp/releases/latest/download/updater.json"
      ]
    }
  }
}
