<Application
    x:Class="SuperAgent.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Custom Brushes & Accent Styling -->
            <SolidColorBrush x:Key="SuperAgentAccentBrush" Color="#6366F1" />
            <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="#4F46E5" />
            <SolidColorBrush x:Key="AssistantMessageBackgroundBrush" Color="#27272A" />
            <CornerRadius x:Key="MessageBubbleCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
