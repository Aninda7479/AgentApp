<Page
    x:Name="ThisPage"
    x:Class="SuperAgent.Views.BrowserLeasingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20" Background="{StaticResource ObsidianDeepBrush}">
        <StackPanel MaxWidth="1180" Spacing="22">
            <!-- Header & Telemetry Strip -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="{StaticResource AccentCyberCyanBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Browser Tab Leasing &amp; WebMCP Bridge" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="Two-tiered tab claiming architecture (claimExistingTab vs createTab), CDP stream telemetry, and in-DOM agent badges." Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource StatusEmeraldBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Leasing Action Deck -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox SelectedValue="{x:Bind ViewModel.SelectedTier, Mode=TwoWay}" SelectedValuePath="Content" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ComboBoxItem Content="createTab" />
                        <ComboBoxItem Content="claimExistingTab" />
                    </ComboBox>
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewTabUrl, Mode=TwoWay}" PlaceholderText="Enter destination URL to lease (e.g. https://github.com or https://stripe.com)..." VerticalAlignment="Center" />
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.LeaseNewTabCommand}" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" Padding="18,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Lease Target Tab" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Active Leased Tabs Cards -->
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource AccentCyanGlowBrush}" />
                        <TextBlock Text="Active Leased Tabs (Two-Tiered Manager)" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#083344" CornerRadius="4" Padding="8,2">
                        <TextBlock Text="CDP Port :9222 Active" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyanGlowBrush}" />
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveTabs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:BrowserLeaseTab">
                            <Border Margin="0,0,0,12" Background="{StaticResource ElevatedCardHoverBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="10" Padding="16">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Tier Badge + Title + In-DOM Badge Pill -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="4" Padding="8,2" Background="#1E1B4B" Margin="0,0,10,0">
                                            <TextBlock Text="{x:Bind Tier}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentVioletGlowBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <!-- In-DOM Agent Badge Indicator -->
                                        <Border Grid.Column="2" Background="#064E3B" CornerRadius="6" Padding="10,4" BorderThickness="1" BorderBrush="{StaticResource StatusEmeraldBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource StatusEmeraldBrush}" />
                                                <TextBlock Text="{x:Bind DomBadgeText}" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource StatusEmeraldBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Middle Row: URL -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind Url}" FontSize="12" Foreground="{StaticResource AccentCyanGlowBrush}" FontFamily="Consolas" />

                                    <!-- Bottom Row: Countdown Progress Bar + Release Button -->
                                    <Grid Grid.Row="2" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Value="{x:Bind RemainingSeconds}" Maximum="{x:Bind TotalSeconds}" VerticalAlignment="Center" Height="6" Foreground="{StaticResource AccentCyberCyanBrush}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind RemainingSeconds}" FontSize="12" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyberCyanBrush}" />
                                            <TextBlock Text="s remaining" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{Binding Path=DataContext.ReleaseLeaseCommand, ElementName=ThisPage}" CommandParameter="{Binding}" Style="{ThemeResource DefaultButtonStyle}" Padding="12,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource StatusCrimsonBrush}" />
                                                <TextBlock Text="Release Lease" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Bottom Split: WebMCP Tools Registry & CDP Stream Log -->
            <Grid ColumnSpacing="16" x:Name="RootPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <!-- Left: WebMCP In-Page Tools -->
                <Border Grid.Column="0" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{StaticResource AccentCyberCyanBrush}" />
                            <TextBlock Text="WebMCP In-Page Tools Registry" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.Tools}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:WebMcpTool">
                                    <Border Margin="0,0,0,10" Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource AccentCyanGlowBrush}" />
                                                <Border Grid.Column="1" Background="#1E1B4B" CornerRadius="4" Padding="6,1">
                                                    <TextBlock Text="{x:Bind CallCount}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AccentVioletGlowBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            <Border Background="#030508" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind SchemaSummary}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Right: CDP Stream Event Log -->
                <Border Grid.Column="1" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="16" Foreground="{StaticResource AccentElectricVioletBrush}" />
                                <TextBlock Text="Chrome DevTools Protocol (CDP) Telemetry Stream" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearCdpEventsCommand}" Style="{ThemeResource DefaultButtonStyle}" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                    <TextBlock Text="Clear" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        
                        <!-- Terminal Log Stage -->
                        <Border Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" Padding="10">
                            <ListView ItemsSource="{x:Bind ViewModel.CdpEvents}" MaxHeight="300" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:CdpStreamEvent">
                                        <Grid ColumnSpacing="10" Padding="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="4" Padding="4,1" Background="#064E3B" HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind Direction}" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource StatusEmeraldBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Method}" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource AccentVioletGlowBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind PayloadSummary}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
