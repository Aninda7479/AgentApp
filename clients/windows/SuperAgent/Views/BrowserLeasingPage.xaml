<Page
    x:Name="ThisPage"
    x:Class="SuperAgent.Views.BrowserLeasingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20">
        <StackPanel MaxWidth="1100" Spacing="20">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Browser Tab Leasing &amp; WebMCP" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Two-tiered tab leasing (claimExistingTab vs createTab), CDP event streaming, and in-DOM agent badges." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" FontWeight="Medium" />
                </Border>
            </Grid>

            <!-- Leasing Action Deck -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox SelectedValue="{x:Bind ViewModel.SelectedTier, Mode=TwoWay}" SelectedValuePath="Content" Width="180">
                        <ComboBoxItem Content="createTab" />
                        <ComboBoxItem Content="claimExistingTab" />
                    </ComboBox>
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewTabUrl, Mode=TwoWay}" PlaceholderText="Enter URL to lease (e.g. https://stripe.com)..." />
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.LeaseNewTabCommand}" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Lease Tab" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Active Leased Tabs Cards -->
            <TextBlock Text="Active Leased Tabs" FontWeight="SemiBold" FontSize="16" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveTabs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:BrowserLeaseTab">
                        <Border Margin="0,0,0,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Tier Badge + Title + In-DOM Badge Pill -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Padding="6,2" Background="#1E1B4B" Margin="0,0,8,0">
                                        <TextBlock Text="{x:Bind Tier}" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <!-- In-DOM Agent Badge Indicator -->
                                    <Border Grid.Column="2" Background="#064E3B" CornerRadius="4" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" />
                                            <TextBlock Text="{x:Bind DomBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#6EE7B7" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Middle Row: URL -->
                                <TextBlock Grid.Row="1" Text="{x:Bind Url}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" />

                                <!-- Bottom Row: Countdown Progress Bar + Release Button -->
                                <Grid Grid.Row="2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Value="{x:Bind RemainingSeconds}" Maximum="{x:Bind TotalSeconds}" VerticalAlignment="Center" Height="6" Foreground="#6366F1" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind RemainingSeconds}" FontSize="12" FontWeight="Bold" Foreground="#8B5CF6" />
                                        <TextBlock Text="s left" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding Path=DataContext.ReleaseLeaseCommand, ElementName=ThisPage}" CommandParameter="{Binding}" Style="{ThemeResource DefaultButtonStyle}">
                                        <TextBlock Text="Release Lease" FontSize="11" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Split: WebMCP Tools Registry & CDP Stream Log -->
            <Grid ColumnSpacing="16" x:Name="RootPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <!-- Left: WebMCP In-Page Tools -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="#06B6D4" />
                            <TextBlock Text="WebMCP In-Page Tools Registry" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.Tools}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:WebMcpTool">
                                    <Border Margin="0,0,0,8" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" FontFamily="Consolas" Foreground="#38BDF8" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind CallCount}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind SchemaSummary}" FontSize="10" FontFamily="Consolas" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Right: CDP Stream Event Log -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="16" Foreground="#8B5CF6" />
                                <TextBlock Text="Chrome DevTools Protocol (CDP) Stream" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearCdpEventsCommand}">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.CdpEvents}" MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:CdpStreamEvent">
                                    <Grid ColumnSpacing="8" Padding="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="3" Padding="4,1" Background="{ThemeResource LayerFillColorAltBrush}">
                                            <TextBlock Text="{x:Bind Direction}" FontSize="9" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Method}" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" Foreground="#C084FC" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind PayloadSummary}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
