<Page
    x:Class="SuperAgent.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24">
        <StackPanel MaxWidth="800" Spacing="24">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Configure SuperAgent daemon connection, model providers, and desktop preferences." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Server Connection Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Core Daemon Connection" FontSize="16" FontWeight="SemiBold" />
                
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Daemon Host &amp; Port" FontWeight="Medium" />
                                <TextBlock Text="Target HTTP and WebSocket loopback endpoint for core_v2 daemon." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="HostTextBox" Text="127.0.0.1" Width="120" />
                                <TextBox x:Name="PortTextBox" Text="1469" Width="80" />
                            </StackPanel>
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Daemon API Token" FontWeight="Medium" />
                                <TextBlock Text="Optional authentication Bearer token configured in ~/.superagent/web-server.lock" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <PasswordBox x:Name="TokenPasswordBox" Grid.Column="1" Width="208" PlaceholderText="superagent-secret" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Connection Status: Ready" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Column="1" Content="Reconnect Daemon" Click="ReconnectButton_Click" Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Model Providers Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Model Providers &amp; API Keys" FontSize="16" FontWeight="SemiBold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Anthropic API Key" FontWeight="Medium" />
                                <TextBlock Text="Claude 3.7 Sonnet, Claude 3.5 Haiku" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <PasswordBox Grid.Column="1" Width="240" PlaceholderText="sk-ant-..." />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="OpenAI API Key" FontWeight="Medium" />
                                <TextBlock Text="GPT-4o, o3-mini" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <PasswordBox Grid.Column="1" Width="240" PlaceholderText="sk-proj-..." />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Google Gemini API Key" FontWeight="Medium" />
                                <TextBlock Text="Gemini 2.0 Flash, Gemini 1.5 Pro" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <PasswordBox Grid.Column="1" Width="240" PlaceholderText="AIzaSy..." />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Local Ollama Endpoint" FontWeight="Medium" />
                                <TextBlock Text="Local offline inference endpoint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="240" Text="http://127.0.0.1:11434" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- General & Diagnostics Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="General &amp; Diagnostics" FontSize="16" FontWeight="SemiBold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="SuperAgent Windows Client" FontWeight="Medium" />
                                <TextBlock Text="WinUI 3 Native (Windows App SDK 1.5+)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="v2.0.0-preview" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Smooth Streaming Animation" FontWeight="Medium" />
                                <TextBlock Text="Animate token streaming and thought disclosure" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="True" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
