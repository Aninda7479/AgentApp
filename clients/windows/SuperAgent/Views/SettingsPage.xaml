<Page
    x:Class="SuperAgent.Views.SettingsPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1180" Spacing="22">
            <!-- Header Telemetry Strip -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Background="{StaticResource AccentElectricVioletBrush}" CornerRadius="6" Width="30" Height="30">
                            <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Settings &amp; System Doctor" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource StatusEmeraldBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.OverallHealthStatus, Mode=OneWay}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusEmeraldBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Configure 24 native intelligence modules, local model runtimes, and real-time hardware diagnostics." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.SaveSettingsCommand}" Style="{ThemeResource AccentButtonStyle}" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                            <TextBlock Text="Save Changes" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Feedback / Notification Banner -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderGlowBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource AccentCyberCyanBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource AccentCyberCyanBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- System Doctor Diagnostic Matrix -->
            <Border Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE890;" FontSize="15" Foreground="{StaticResource StatusEmeraldBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="SYSTEM DOCTOR ENVIRONMENT DIAGNOSTICS" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Automated hardware capability, WGC capture readiness, and core daemon loopback probe." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.RunSystemDoctorCommand}" Style="{ThemeResource DefaultButtonStyle}" Height="32">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource StatusEmeraldBrush}" />
                                <TextBlock Text="Run Diagnostics" FontFamily="Consolas" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Diagnostics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="275" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:SystemDoctorDiagnostic">
                                <Border Margin="0,0,10,10" Background="{StaticResource ElevatedCardBrush}" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Component}" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#064E3B" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind Status}" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="#34D399" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Details}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Daemon Connection & Core Config -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE753;" FontSize="15" Foreground="{StaticResource AccentCyberCyanBrush}" />
                        <TextBlock Text="CORE DAEMON RPC CONNECTION" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Axum Loopback HTTP &amp; WebSocket Port" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Target loopback endpoint for core_v2 Axum daemon (/ws on port 1469)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox Text="{x:Bind ViewModel.DaemonHost, Mode=TwoWay}" Width="140" PlaceholderText="127.0.0.1" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.DaemonPort, Mode=TwoWay}" Width="85" PlaceholderText="1469" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Button Content="Reconnect" Click="ReconnectButton_Click" Style="{ThemeResource AccentButtonStyle}" Height="34" FontFamily="Consolas" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 24-Module Settings Catalog Section -->
            <StackPanel Spacing="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="MODULE CONFIGURATION MATRIX (24 MODULES)" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Select a module card to inspect or customize parameters." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <AutoSuggestBox
                        Grid.Column="1"
                        PlaceholderText="Filter 24 modules..."
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                        Background="{StaticResource StageTerminalBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </Grid>

                <!-- Category Filters Row -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="All (24)" Tag="All" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                        <Button Content="System" Tag="System" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                        <Button Content="Intelligence" Tag="Intelligence" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                        <Button Content="Integrations" Tag="Integrations" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                        <Button Content="Automation" Tag="Automation" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                        <Button Content="Creative" Tag="Creative" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                        <Button Content="Security" Tag="Security" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                        <Button Content="Hardware" Tag="Hardware" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                        <Button Content="Voice" Tag="Voice" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                        <Button Content="Companion" Tag="Companion" Click="CategoryFilter_Click" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,5" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Module Cards Grid -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredModules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="375" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:SettingsModule">
                            <Border Margin="0,0,12,12" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="10" Padding="16">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Icon, Title, Category -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{StaticResource AccentCyberCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind Category}" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentElectricVioletBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Middle: Description -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />

                                    <!-- Bottom: Status Pill + Configure Button -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource StatusEmeraldBrush}" />
                                            <TextBlock Text="{x:Bind StatusSummary}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource StatusEmeraldBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Configure" FontSize="11" FontFamily="Consolas" Padding="10,4" Style="{ThemeResource DefaultButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
