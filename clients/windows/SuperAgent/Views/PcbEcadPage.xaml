<Page
    x:Class="SuperAgent.Views.PcbEcadPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1180" Spacing="22">
            <!-- Header Telemetry Strip -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Background="{StaticResource AccentCyberCyanBrush}" CornerRadius="6" Width="30" Height="30">
                            <FontIcon Glyph="&#xE90F;" FontSize="15" Foreground="#080B11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PCB &amp; Hardware ECAD Studio" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource StatusEmeraldBrush}" />
                                <TextBlock Text="KICAD 9 BRIDGE ONLINE" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusEmeraldBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Circuit schematic editor, copper layer layout, real-time ERC rules checker, and KiCad/BOM exporter." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Action Buttons: KiCad Export & BOM CSV -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ExportKiCadCommand}" Style="{ThemeResource DefaultButtonStyle}" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{StaticResource AccentCyberCyanBrush}" />
                            <TextBlock Text="Export KiCad 9" FontFamily="Consolas" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ExportBomCommand}" Style="{ThemeResource AccentButtonStyle}" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                            <TextBlock Text="Generate BOM CSV" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Mode Selector Bar (Schematic, Copper Layout, 3D Preview) -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Schematic View" Command="{x:Bind ViewModel.SetViewModeCommand}" CommandParameter="Schematic" Style="{ThemeResource AccentButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,6" />
                        <Button Content="PCB Copper Layout" Command="{x:Bind ViewModel.SetViewModeCommand}" CommandParameter="Layout" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,6" />
                        <Button Content="3D Board Preview" Command="{x:Bind ViewModel.SetViewModeCommand}" CommandParameter="3DPreview" Style="{ThemeResource DefaultButtonStyle}" FontFamily="Consolas" FontSize="11" Padding="12,6" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentCyberCyanBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Main ECAD Split Stage -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Interactive Schematic & Copper Canvas -->
                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="12">
                            <!-- Canvas Telemetry Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="EDA SCHEMATIC STAGE" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <Border Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyberCyanBrush}" />
                                    </Border>
                                    <Border Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="2-Layer FR4 1.6mm" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Grid: 0.1mm | Snap: ON" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Canvas Visual Area with Schematic Simulation -->
                            <Border Height="340" Background="#05080E" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8">
                                <Grid>
                                    <!-- Grid lines simulation -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                        <Border Width="70" Height="70" CornerRadius="35" Background="#0B132B" BorderBrush="{StaticResource AccentCyberCyanBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE90F;" FontSize="32" Foreground="{StaticResource AccentCyberCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="6 Components Placed | 6 Power/Signal Nets Routed" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentCyberCyanBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Circuit Schematic Elements Simulation Overlay -->
                                    <Canvas>
                                        <Border Canvas.Left="35" Canvas.Top="35" Background="#091424" BorderThickness="1" BorderBrush="#06B6D4" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="J1: USB-C 5V" FontSize="10" FontFamily="Consolas" Foreground="#E0F2FE" />
                                        </Border>
                                        <Line X1="130" Y1="50" X2="200" Y2="50" Stroke="#EF4444" StrokeThickness="2" />
                                        <Border Canvas.Left="200" Canvas.Top="35" Background="#091424" BorderThickness="1" BorderBrush="#10B981" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="U2: AMS1117-3.3" FontSize="10" FontFamily="Consolas" Foreground="#D1FAE5" />
                                        </Border>
                                        <Line X1="315" Y1="50" X2="380" Y2="50" Stroke="#10B981" StrokeThickness="2" />
                                        <Border Canvas.Left="380" Canvas.Top="25" Background="#091424" BorderThickness="2" BorderBrush="#8B5CF6" CornerRadius="4" Padding="12,8">
                                            <TextBlock Text="U1: ESP32-S3-WROOM-1" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="#EDE9FE" />
                                        </Border>
                                    </Canvas>

                                    <!-- Canvas HUD Overlay Telemetry Strip -->
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Background="#080B11" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="X: 142.50mm" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="Y: 88.20mm" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="Layers: F.Cu / B.Cu" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource AccentCyberCyanBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Components & Footprints Table -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{StaticResource AccentCyberCyanBrush}" />
                                    <TextBlock Text="BILL OF MATERIALS (BOM) PART REGISTRY" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Click item to inspect footprint" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <ListView ItemsSource="{x:Bind ViewModel.Components}" SelectedItem="{x:Bind ViewModel.SelectedComponent, Mode=TwoWay}" SelectionMode="Single" MaxHeight="160">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:PcbComponent">
                                        <Border Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Designator}" FontWeight="Bold" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentCyberCyanBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Mpn}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind LcscId}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AccentElectricVioletBrush}" HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{x:Bind Footprint}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Real-Time ERC Rules Checker & AI Hardware Co-Pilot -->
                <Border Grid.Column="1" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="16">
                        <!-- Real-time ERC Checker -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource AccentAmberEmberBrush}" />
                                <TextBlock Text="ELECTRICAL RULES CHECK (ERC)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.RunErcCheckCommand}" Style="{ThemeResource DefaultButtonStyle}" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource AccentAmberEmberBrush}" />
                                    <TextBlock Text="Re-Check" FontFamily="Consolas" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.ErcViolations}" MaxHeight="160">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:ErcRuleViolation">
                                    <Border Margin="0,0,0,6" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind RuleId}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentAmberEmberBrush}" />
                                                <Border Grid.Column="1" Background="#451A03" CornerRadius="3" Padding="5,1">
                                                    <TextBlock Text="{x:Bind Severity}" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentAmberEmberBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Message}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- AI Hardware Co-Pilot -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE99A;" FontSize="14" Foreground="{StaticResource AccentCyberCyanBrush}" />
                            <TextBlock Text="AI HARDWARE CO-PILOT" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Co-Pilot Messages Terminal Feed -->
                        <Border Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Height="150">
                            <ListView ItemsSource="{x:Bind ViewModel.AiCopilotMessages}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,3" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.CoPilotInput, Mode=TwoWay}" PlaceholderText="Ask hardware co-pilot (e.g. check decoupling caps)..." Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.SendCoPilotMessageCommand}" Style="{ThemeResource AccentButtonStyle}" Width="38" Height="34">
                                <FontIcon Glyph="&#xE724;" FontSize="12" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
