<Page
    x:Class="SuperAgent.Views.ReplConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <Grid Padding="28,20" RowSpacing="18" Background="{StaticResource ObsidianDeepBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Action Strip -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE756;" FontSize="24" Foreground="{StaticResource AccentElectricVioletBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="In-Process Scripting &amp; REPL Console" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="Virtualized 25,000 token execution buffer, ANSI color syntax parser, and live scope variable tree." Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.ResetSessionCommand}" Background="#450A0A" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" FontSize="11" Foreground="{StaticResource StatusCrimsonBrush}" />
                        <TextBlock Text="Reset Context (js_reset)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StatusCrimsonBrush}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearOutputCommand}" Style="{ThemeResource DefaultButtonStyle}" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                        <TextBlock Text="Clear Buffer" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Workspace: Console Stream + Scope Inspector -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Console Log Buffer (Cybernetic Terminal Stage) -->
            <Border Grid.Column="0" Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Terminal Status Bar & Token Budget Gauge -->
                    <Border Grid.Row="0" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusEmeraldBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.EngineVersion, Mode=OneWay}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Token Budget:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource StageTerminalBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.TokenGaugeText, Mode=OneWay}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyanGlowBrush}" />
                                </Border>
                                <ProgressBar Value="{x:Bind ViewModel.TokenPercentage, Mode=OneWay}" Maximum="100" Width="70" Height="4" Foreground="{StaticResource AccentCyberCyanBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable Log Stream -->
                    <Border Grid.Row="1" Background="#030508" BorderThickness="1" BorderBrush="#0D1524" CornerRadius="8" Padding="12">
                        <ListView ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:ReplLogLine">
                                    <Grid ColumnSpacing="10" Padding="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind LineIndex}" FontSize="11" FontFamily="Consolas" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Border>

            <!-- Live Variable & Scope Inspector Tree -->
            <Border Grid.Column="1" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE81E;" FontSize="15" Foreground="{StaticResource AccentElectricVioletBrush}" />
                        <TextBlock Text="Live Scope &amp; Variables Tree" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    
                    <ListView ItemsSource="{x:Bind ViewModel.ScopeVariables}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:ReplVariableNode">
                                <Border Margin="0,0,0,8" Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" Padding="10">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource AccentCyanGlowBrush}" />
                                            <Border Grid.Column="1" Background="#1E1B4B" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{x:Bind Type}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AccentVioletGlowBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Value}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cybernetic Command Input Bar -->
        <Border Grid.Row="2" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource StageTerminalBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text=">" FontSize="16" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AccentCyberCyanBrush}" />
                </Border>
                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentCommand, Mode=TwoWay}" FontFamily="Consolas" PlaceholderText="Type JavaScript or CUA command (e.g. await sky.click([#10]); or pcb.inspect('U1'))..." VerticalAlignment="Center" Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="6" />
                <Button Grid.Column="2" Command="{x:Bind ViewModel.ExecuteCommandCommand}" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="11" />
                        <TextBlock Text="Execute" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
