<Page
    x:Class="SuperAgent.Views.ReplConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <Grid Padding="28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="REPL Console &amp; JavaScript Sandbox" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Virtualized 25,000 token buffer, ANSI output parser, and live scope inspector." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.ResetSessionCommand}" Style="{ThemeResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" FontSize="12" Foreground="#EF4444" />
                        <TextBlock Text="Reset Context (js_reset)" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearOutputCommand}">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Workspace: Console Stream + Scope Inspector -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Console Log Buffer (Simulated Terminal) -->
            <Border Grid.Column="0" Background="#0A0F1D" BorderThickness="1" BorderBrush="#1E293B" CornerRadius="10" Padding="14">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Terminal Status Bar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" />
                            <TextBlock Text="QuickJS REPL Terminal" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Token Budget:" FontSize="11" Foreground="#64748B" />
                            <TextBlock Text="{x:Bind ViewModel.TotalTokens, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#06B6D4" />
                            <TextBlock Text="/ 25,000" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Log Stream -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:ReplLogLine">
                                <Grid ColumnSpacing="8" Padding="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind LineIndex}" FontSize="11" FontFamily="Consolas" Foreground="#475569" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Live Variable & Scope Inspector Tree -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="14">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81E;" FontSize="14" Foreground="#8B5CF6" />
                        <TextBlock Text="Live Scope &amp; Variables Tree" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                    <ListView ItemsSource="{x:Bind ViewModel.ScopeVariables}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:ReplVariableNode">
                                <Border Margin="0,0,0,6" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="8">
                                    <StackPanel Spacing="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="#38BDF8" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Type}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Value}" FontSize="11" FontFamily="Consolas" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Command Input Bar -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text=">" FontSize="16" FontWeight="Bold" FontFamily="Consolas" Foreground="#06B6D4" VerticalAlignment="Center" Margin="4,0" />
                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.CurrentCommand, Mode=TwoWay}" FontFamily="Consolas" PlaceholderText="Type JavaScript or Node command (e.g. pcb.inspect('U1'))..." />
                <Button Grid.Column="2" Command="{x:Bind ViewModel.ExecuteCommandCommand}" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                        <TextBlock Text="Eval" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
