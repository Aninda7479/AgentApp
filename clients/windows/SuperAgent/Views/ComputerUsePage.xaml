<Page
    x:Class="SuperAgent.Views.ComputerUsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20" Background="{StaticResource ObsidianDeepBrush}">
        <StackPanel MaxWidth="1180" Spacing="22">
            <!-- Header & Real-Time Telemetry HUD -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7F4;" FontSize="24" Foreground="{StaticResource AccentCyanGlowBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Computer Use &amp; Direct3D Desktop Automation" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="Windows Graphics Capture (WGC), Win32 coordinate unscaling, UI accessibility indexing, and adaptive mouse settling." Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                
                <!-- HUD Pill Strip -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#064E3B" CornerRadius="8" Padding="12,6" BorderThickness="1" BorderBrush="{StaticResource StatusEmeraldBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource StatusEmeraldBrush}" />
                            <TextBlock Text="60.0 FPS WGC Direct3D11" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource StatusEmeraldBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsSettling, Mode=OneWay}" Width="14" Height="14" Foreground="{StaticResource AccentCyberCyanBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Target Window Selection HUD -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{StaticResource AccentCyberCyanBrush}" />
                            <TextBlock Text="Active Top-Level Windows (Win32 EnumWindows Target Picker)" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#083344" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="{x:Bind ViewModel.Windows.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanGlowBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshWindowsCommand}" Style="{ThemeResource DefaultButtonStyle}" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource AccentCyberCyanBrush}" />
                                <TextBlock Text="Rescan Desktop Windows" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Windows}" SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" SelectionMode="Single" MaxHeight="160">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:WindowTargetItem">
                                <Grid Padding="10,6" Margin="0,2" CornerRadius="6" Background="{StaticResource ElevatedCardHoverBrush}" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE737;" FontSize="14" Foreground="{StaticResource AccentElectricVioletBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ProcessName}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource StageTerminalBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Bounds}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AccentCyanGlowBrush}" />
                                    </Border>
                                    <Border Grid.Column="3" CornerRadius="4" Padding="6,2" Background="#1E1B4B" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Hwnd}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AccentVioletGlowBrush}" />
                                    </Border>
                                    <Border Grid.Column="4" CornerRadius="4" Padding="6,2" Background="#451A03" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind OcclusionStatus}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentAmberEmberBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Main Stage: Capture Canvas + Accessibility Inspector -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: WGC Capture Canvas & Trajectory Visualizer -->
                <Border Grid.Column="0" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="{StaticResource StatusEmeraldBrush}" />
                                <TextBlock Text="WGC Occluded Window Capture Stage" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Settling Countdown:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Border Background="{StaticResource StageTerminalBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.SettlingRemainingMs, Mode=OneWay}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyanGlowBrush}" />
                                </Border>
                                <TextBlock Text="ms" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Simulated Screen Capture Canvas with Cyber Reticle -->
                        <Border Height="300" Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="10">
                            <Grid>
                                <!-- Reticle Grid Lines -->
                                <Canvas>
                                    <Line X1="0" Y1="150" X2="600" Y2="150" Stroke="#1E283D" StrokeThickness="1" StrokeDashArray="4 4" />
                                    <Line X1="300" Y1="0" X2="300" Y2="300" Stroke="#1E283D" StrokeThickness="1" StrokeDashArray="4 4" />
                                </Canvas>

                                <!-- Screen Mock Content -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="42" Foreground="{StaticResource AccentElectricVioletBrush}" />
                                    <TextBlock Text="Direct3D 11 Surface (1920x1080 -> 720p Sub-sampling)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Target: Visual Studio Code [PID: 14288 • HWND: 0x002A04F2]" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <!-- Simulated Cursor & Trajectory Overlay -->
                                <Canvas>
                                    <Polyline Points="80,220 180,180 320,120 480,60" Stroke="{StaticResource AccentCyberCyanBrush}" StrokeThickness="2" StrokeDashArray="4 2" />
                                    <Ellipse Canvas.Left="475" Canvas.Top="55" Width="10" Height="10" Fill="{StaticResource StatusCrimsonBrush}" />
                                    <Border Canvas.Left="430" Canvas.Top="25" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource AccentCyberCyanBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="v: 1100 px/s | [#10] EditorPane" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyanGlowBrush}" />
                                    </Border>
                                </Canvas>

                                <!-- Canvas Footer HUD telemetry -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8" Background="#000000" Opacity="0.85" CornerRadius="6" Padding="10,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cursor: [X: 842, Y: 460] (Unscaled DIP: [X: 673, Y: 368] @ 125% DPI)" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="WGC Frame Pool: OK" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource StatusEmeraldBrush}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Mouse Trajectory Velocity Feed -->
                        <TextBlock Text="Mouse Trajectory Velocity Log" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        <Border Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" Padding="10">
                            <ListView ItemsSource="{x:Bind ViewModel.TrajectoryPoints}" MaxHeight="130">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:MouseTrajectoryPoint">
                                        <Grid ColumnSpacing="14" Padding="6,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Action}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyberCyanBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TimestampMs}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind VelocityPixelsPerSec}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource StatusEmeraldBrush}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind X}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Live Accessibility Tree Inspector -->
                <Border Grid.Column="1" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81E;" FontSize="16" Foreground="{StaticResource AccentElectricVioletBrush}" />
                            <TextBlock Text="Accessibility Tree Inspector (Win32 UI Automation)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Tree Details Card -->
                        <Border Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Active Element Details" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Element Index:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="[#10] EditorPane" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentVioletGlowBrush}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Role / Class:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="EditorPane (Rust Code View)" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bounding Box:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="[280, 35, 1640, 1000]" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentCyanGlowBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hierarchy Mock Nodes with Cyber Identifiers -->
                        <TextBlock Text="Interactive Hierarchy Nodes" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <StackPanel Spacing="6">
                            <Border Background="{StaticResource ElevatedCardHoverBrush}" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="[#0] Window: Visual Studio Code" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                            <Border Margin="12,0,0,0" Background="{StaticResource ElevatedCardHoverBrush}" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="[#1] MenuBar: Application Menu" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                            <Border Margin="12,0,0,0" Background="#1E1B4B" BorderThickness="1" BorderBrush="{StaticResource AccentElectricVioletBrush}" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="[#10] EditorPane: src/main.rs (FOCUSED)" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AccentVioletGlowBrush}" />
                            </Border>
                            <Border Margin="24,0,0,0" Background="{StaticResource ElevatedCardHoverBrush}" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="[#11] Button: Run Tests (1400, 45, 100, 30)" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border Margin="24,0,0,0" Background="{StaticResource ElevatedCardHoverBrush}" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="[#12] Button: Debug Crate (1510, 45, 110, 30)" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Settling Countdown Trigger -->
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.TriggerSettlingDelayCommand}" Style="{ThemeResource AccentButtonStyle}" Margin="0,8,0,0" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE916;" FontSize="12" />
                                <TextBlock Text="Test Adaptive Settling Delay (800ms hold)" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
