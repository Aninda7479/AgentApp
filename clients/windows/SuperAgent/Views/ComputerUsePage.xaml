<Page
    x:Class="SuperAgent.Views.ComputerUsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20">
        <StackPanel MaxWidth="1100" Spacing="20">
            <!-- Header & Status Pill -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Computer Use &amp; Desktop Automation" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Windows Graphics Capture (WGC), live UI accessibility inspection, and adaptive mouse settling." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsSettling, Mode=OneWay}" Width="16" Height="16" />
                        <TextBlock Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}" FontSize="12" FontWeight="Medium" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Window Picker Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="#06B6D4" />
                            <TextBlock Text="Target Window Selection" FontWeight="SemiBold" FontSize="15" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshWindowsCommand}" Style="{ThemeResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="Refresh Windows" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Windows}" SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:WindowTargetItem">
                                <Grid Padding="6,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE737;" FontSize="14" Foreground="#8B5CF6" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ProcessName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Bounds}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="3" CornerRadius="4" Padding="6,2" Background="{ThemeResource LayerFillColorAltBrush}">
                                        <TextBlock Text="{x:Bind OcclusionStatus}" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Main Stage: Capture Canvas + Accessibility Inspector -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: WGC Capture Canvas & Trajectory Visualizer -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="#10B981" />
                                <TextBlock Text="WGC Occluded Window Capture Canvas" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Adaptive Settling:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SettlingRemainingMs, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="ms" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Simulated Screen Capture Canvas -->
                        <Border Height="280" Background="#0F172A" BorderThickness="1" BorderBrush="#334155" CornerRadius="8">
                            <Grid>
                                <!-- Screen Mock Content -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="36" Foreground="#6366F1" />
                                    <TextBlock Text="Windows Graphics Capture (Direct3D11 Surface)" FontSize="12" Foreground="#94A3B8" />
                                    <TextBlock Text="Target: Visual Studio Code [1920x1080 -> 720p Surface]" FontSize="11" Foreground="#64748B" />
                                </StackPanel>

                                <!-- Simulated Cursor & Trajectory Overlay -->
                                <Canvas>
                                    <Polyline Points="120,100 250,180 400,120 520,60" Stroke="#06B6D4" StrokeThickness="2" StrokeDashArray="4 2" />
                                    <Ellipse Canvas.Left="515" Canvas.Top="55" Width="10" Height="10" Fill="#EF4444" />
                                    <Border Canvas.Left="530" Canvas.Top="45" Background="#1E293B" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="v: 1100 px/s | element_index: 10" FontSize="10" Foreground="#F8FAFC" />
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- Mouse Trajectory Velocity Feed -->
                        <TextBlock Text="Mouse Trajectory Velocity Log" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0" />
                        <ListView ItemsSource="{x:Bind ViewModel.TrajectoryPoints}" MaxHeight="140">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:MouseTrajectoryPoint">
                                    <Grid ColumnSpacing="12" Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Action}" FontSize="11" FontWeight="SemiBold" Foreground="#06B6D4" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind TimestampMs}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind VelocityPixelsPerSec}" FontSize="11" Foreground="#10B981" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind X}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Right: Live Accessibility Tree Inspector -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81E;" FontSize="16" Foreground="#8B5CF6" />
                            <TextBlock Text="Accessibility Tree Inspector" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>

                        <!-- Tree Details Card -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Active Node Details" FontWeight="SemiBold" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Element Index:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="10 (EditorPane)" FontSize="11" FontWeight="Bold" Foreground="#6366F1" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Role / Type:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="EditorPane (Rust Code View)" FontSize="11" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bounding Box:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="280,35,1640,1000" FontSize="11" FontFamily="Consolas" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hierarchy Mock Nodes -->
                        <TextBlock Text="Element Hierarchy" FontWeight="SemiBold" FontSize="13" />
                        <StackPanel Spacing="4">
                            <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="8,6">
                                <TextBlock Text="[0] Window: Visual Studio Code" FontSize="12" FontFamily="Consolas" />
                            </Border>
                            <Border Margin="12,0,0,0" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="8,6">
                                <TextBlock Text="[1] MenuBar: Application Menu" FontSize="12" FontFamily="Consolas" />
                            </Border>
                            <Border Margin="12,0,0,0" Background="#1E1B4B" BorderThickness="1" BorderBrush="#6366F1" CornerRadius="6" Padding="8,6">
                                <TextBlock Text="[10] EditorPane: src/main.rs (FOCUSED)" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="#A5B4FC" />
                            </Border>
                            <Border Margin="24,0,0,0" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="8,6">
                                <TextBlock Text="[11] Button: Run Tests (1400,45,100,30)" FontSize="12" FontFamily="Consolas" />
                            </Border>
                            <Border Margin="24,0,0,0" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="8,6">
                                <TextBlock Text="[12] Button: Debug Crate (1510,45,110,30)" FontSize="12" FontFamily="Consolas" />
                            </Border>
                        </StackPanel>

                        <!-- Settling Countdown Trigger -->
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.TriggerSettlingDelayCommand}" Style="{ThemeResource AccentButtonStyle}" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE916;" FontSize="12" />
                                <TextBlock Text="Test Adaptive Settling Delay (800ms)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
