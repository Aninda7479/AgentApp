<Page
    x:Class="SuperAgent.Views.SecurityGuardianPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20">
        <StackPanel MaxWidth="1100" Spacing="20">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEA18;" FontSize="24" Foreground="#818CF8" VerticalAlignment="Center" />
                        <TextBlock Text="Security Guardian &amp; LockScreen Vault" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="4-tier confirmation governance, 16 zo decision vectors, and hardware scrypt key recovery." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="OpenDialogButton_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12" />
                            <TextBlock Text="Test Dialog Popup" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Feedback Banner -->
            <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#818CF8" />
                    <TextBlock Text="{x:Bind ViewModel.ActionFeedback, Mode=OneWay}" FontSize="12" FontWeight="Medium" />
                </StackPanel>
            </Border>

            <!-- LockScreen Guardian Shield Banner -->
            <Border Background="#1E1B4B" BorderThickness="1" BorderBrush="#6366F1" CornerRadius="10" Padding="18,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA18;" FontSize="32" Foreground="#818CF8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.ShieldStatus, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" Foreground="#EEF2FF" />
                        <TextBlock Text="Hardware-enforced scrypt key storage + zero-leak memory isolation. Intercepts untrusted clipboard and terminal escalations." FontSize="12" Foreground="#C7D2FE" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsLockScreenArmed, Mode=TwoWay}" Command="{x:Bind ViewModel.ToggleLockScreenCommand}" OnContent="Armed" OffContent="Disarmed" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 4-Tier Confirmation Governance -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="4-Tier Confirmation Governance" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Adaptive safety gating for autonomous agent execution and system modification." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveTier, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="#818CF8" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="0" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tier 0: Hand-Off" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="Read-only observation. Requires confirmation on every action." FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="1" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tier 1: Always Confirm" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="Interactive prompt for write commands and tab switches." FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="2" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tier 2: Pre-Approval" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="Pre-authorize planned steps; prompt on security deviations." FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="3" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tier 3: Autonomous" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="High-trust unattended loop with zo runtime safety bounds." FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- zo Security Decision Badges (16-State Policy) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="zo Security Decision Badges (16-State Policy Vectors)" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Deterministic behavioral constraint rules enforced before each tool invocation." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Rule zo-04 Active" FontSize="11" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Badges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:ZoSecurityDecisionBadge">
                                    <Button Command="{Binding ElementName=BadgesRoot, Path=ViewModel.SelectBadgeCommand}" CommandParameter="{x:Bind}" Padding="0" BorderThickness="0" Background="Transparent">
                                        <Border CornerRadius="6" Padding="10,6" Background="{ThemeResource LayerFillColorAltBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="8" Height="8" Fill="#10B981" />
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Label}" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Severity}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Credential Vault 7-Branch Recovery Protocols -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Credential Vault 7-Branch Recovery Protocols" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Hardware-isolated token rotation and zero-leak recovery runbooks." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.RecoveryBranches}"
                        SelectedItem="{x:Bind ViewModel.SelectedBranch, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:CredentialRecoveryBranch">
                                <Grid Padding="8,8" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Padding="6,3" Background="{ThemeResource LayerFillColorAltBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind BranchId}" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ActionName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind ProtocolSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind RiskRating}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Grid.Column="3" Content="Execute" Style="{ThemeResource DefaultButtonStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
