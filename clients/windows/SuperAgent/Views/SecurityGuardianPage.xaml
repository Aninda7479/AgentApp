<Page
    x:Name="ThisPage"
    x:Class="SuperAgent.Views.SecurityGuardianPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20" Background="{StaticResource ObsidianDeepBrush}">
        <StackPanel MaxWidth="1180" Spacing="22">
            <!-- Header & Action Strip -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEA18;" FontSize="24" Foreground="{StaticResource StatusEmeraldBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Security Guardian &amp; LockScreen Vault" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="4-tier confirmation governance, CUALockScreen watchdog (WTS_SESSION_LOCK), 16 zo decision vectors, and credential vault." Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Click="OpenDialogButton_Click" Style="{ThemeResource AccentButtonStyle}" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12" />
                            <TextBlock Text="Launch Confirmation Modal" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Feedback Telemetry Strip -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyberCyanBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ActionFeedback, Mode=OneWay}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Hardware scrypt Active" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource StatusEmeraldBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- CUALockScreen Guardian Shield Banner -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource AccentElectricVioletBrush}" CornerRadius="12" Padding="20,16">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#1E1B4B" CornerRadius="10" Padding="12" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEA18;" FontSize="32" Foreground="{StaticResource AccentVioletGlowBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.ShieldStatus, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#083344" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="{x:Bind ViewModel.WtsSessionStatus, Mode=OneWay}" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyanGlowBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Continuous Win32 WTSRegisterSessionNotification watchdog. Automatically freezes synthetic mouse &amp; keyboard injection upon desktop lock (Win+L / UAC screen)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsLockScreenArmed, Mode=TwoWay}" OnContent="Watchdog: Armed" OffContent="Watchdog: Disarmed" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 4-Tier Confirmation Governance Deck -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="4-Tier Confirmation Governance Taxonomy" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Multi-level authorization gating dynamically adapted based on command blast radius." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1E1B4B" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ActiveTierTitle, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentVioletGlowBrush}" />
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="0" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Padding="14,12" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource StatusCrimsonBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Mode 1: Hand-Off" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Mandates human takeover for all write commands, payments, password resets." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="1" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Padding="14,12" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentAmberEmberBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Mode 2: Always Confirm" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Modal confirmation required for financial transfers, shell executions, file deletions." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="2" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Padding="14,12" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource AccentCyberCyanBrush}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentCyberCyanBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Mode 3: Pre-Approval" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Pre-authorizes planned execution steps; dynamically halts upon scope escalation." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="3" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Padding="14,12" Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource StatusEmeraldBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Mode 4: No Confirm" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Autonomous execution with zero prompts for benign dismissals and cookie banners." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cross-Origin Iframe Credential Validator -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Cross-Origin Iframe &amp; Credential Delivery Validator" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Prevents credential harvesting via embedded unauthorized iframe targets." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#450A0A" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="⚠️ Cross-Origin Mismatch Detected" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StatusCrimsonBrush}" />
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource StageTerminalBrush}" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Top-Level Document Origin" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TopLevelOrigin, Mode=OneWay}" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanGlowBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource StageTerminalBrush}" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="{StaticResource StatusCrimsonBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Credential Frame Target Origin" FontSize="11" Foreground="{StaticResource StatusCrimsonBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CredentialFrameOrigin, Mode=OneWay}" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource StatusCrimsonBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource StageTerminalBrush}" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Form Submission Action" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FormSubmissionOrigin, Mode=OneWay}" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- zo Security Decision Badges (16-State Policy Vectors) -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="zo Security Decision Machine (16-State Policy Vectors)" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Deterministic behavioral constraint rules evaluated before each tool invocation." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#083344" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="16 Vectors Loaded" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyanGlowBrush}" />
                        </Border>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Badges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:ZoSecurityDecisionBadge">
                                    <Button Command="{Binding ElementName=ThisPage, Path=ViewModel.SelectBadgeCommand}" CommandParameter="{Binding}" Padding="0" BorderThickness="0" Background="Transparent">
                                        <Border CornerRadius="8" Padding="12,8" Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusEmeraldBrush}" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Label}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Severity}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource AccentCyanGlowBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Credential Vault 7-Branch Recovery Protocols -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Credential Vault 7-Branch Recovery Protocols" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Hardware-isolated token rotation and zero-leak recovery runbooks." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.RecoveryBranches}"
                        SelectedItem="{x:Bind ViewModel.SelectedBranch, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:CredentialRecoveryBranch">
                                <Grid Padding="12,10" Margin="0,3" CornerRadius="8" Background="{StaticResource ElevatedCardHoverBrush}" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Padding="8,3" Background="#1E1B4B" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind BranchId}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentVioletGlowBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ActionName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ProtocolSummary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#451A03" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{x:Bind RiskRating}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentAmberEmberBrush}" />
                                    </Border>
                                    <Button Grid.Column="3" Content="Execute Branch" Style="{ThemeResource AccentButtonStyle}" Padding="12,5" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
