<Page
    x:Class="SuperAgent.Views.CompanionPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1180" Spacing="22">
            <!-- Header Telemetry Strip -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Background="{StaticResource AccentElectricVioletBrush}" CornerRadius="6" Width="30" Height="30">
                            <FontIcon Glyph="&#xE76E;" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Companion &amp; 3D Pet Ecosystem" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource StatusEmeraldBrush}" />
                                <TextBlock Text="VRM 1.0 RIGGED • 60 FPS PHYSICS" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusEmeraldBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="VRM 3D humanoid partner, procedural lip-sync, mood state engine, and floating desktop pet." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Action Button: Floating Desktop Pet Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="MODE:" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.IsFloatingPetActive, Mode=OneWay}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentElectricVioletBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Command="{x:Bind ViewModel.ToggleFloatingPetCommand}" Style="{ThemeResource AccentButtonStyle}" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE737;" FontSize="13" />
                            <TextBlock Text="Pop Out Desktop Pet" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Stage: 3D Avatar Viewport + Emotion & Audio Inspector -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Holographic 3D VRM Companion Canvas -->
                <Border Grid.Column="0" Background="{StaticResource StageTerminalBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderGlowBrush}" CornerRadius="12" Padding="20" Height="440">
                    <Grid>
                        <!-- Holographic Avatar Portal Reticle -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                            <!-- Glowing Avatar Ring -->
                            <Grid Width="160" Height="160">
                                <Ellipse Stroke="{StaticResource AccentVioletGlowBrush}" StrokeThickness="2" Opacity="0.6" />
                                <Ellipse Stroke="{StaticResource AccentCyberCyanBrush}" StrokeThickness="1" StrokeDashArray="4 2" Margin="8" />
                                <Border Width="120" Height="120" CornerRadius="60" Background="#0C101B" BorderThickness="2" BorderBrush="{StaticResource AccentElectricVioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE76E;" FontSize="54" Foreground="{StaticResource AccentVioletGlowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{x:Bind ViewModel.CompanionName, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            
                            <!-- Badges Row -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Border CornerRadius="4" Padding="8,3" Background="#064E3B" BorderBrush="{StaticResource StatusEmeraldBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource StatusEmeraldBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveMood, Mode=OneWay}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource StatusEmeraldBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="4" Padding="8,3" Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <TextBlock Text="Spring Bones Active" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentCyberCyanBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="8,3" Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <TextBlock Text="Lip-Sync: FFT Active" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Speech Balloon Feedback Message -->
                            <Border Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" MaxWidth="440" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- Floating Telemetry Gauges (Top Right) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="{StaticResource ElevatedCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEB51;" FontSize="12" Foreground="#EC4899" />
                                    <TextBlock Text="INTIMACY:" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.IntimacyLevel, Mode=OneWay}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="%" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE83F;" FontSize="12" Foreground="{StaticResource StatusEmeraldBrush}" />
                                    <TextBlock Text="BATTERY:" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.BatteryLevel, Mode=OneWay}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StatusEmeraldBrush}" />
                                    <TextBlock Text="%" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Model Path Readout (Bottom Left) -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#080B11" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="{x:Bind ViewModel.VrmModelPath, Mode=OneWay}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: Emotion Badges & Audio Viseme Meter -->
                <Border Grid.Column="1" Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="16">
                        <!-- Mood Reaction Badges -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEB51;" FontSize="14" Foreground="{StaticResource AccentElectricVioletBrush}" />
                            <TextBlock Text="EMOTION &amp; MOOD BADGES" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Moods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:CompanionMoodBadge">
                                    <Button
                                        Command="{Binding Path=DataContext.SetMoodCommand, ElementName=ThisPage}"
                                        CommandParameter="{Binding}"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Margin="0,0,0,6">
                                        <Border Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14" Background="#1E1B4B" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="13" Foreground="{StaticResource AccentVioletGlowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Mood}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Audio Viseme Lip-Sync Meter -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <FontIcon Glyph="&#xE720;" FontSize="14" Foreground="{StaticResource AccentCyberCyanBrush}" />
                            <TextBlock Text="AUDIO VISEME FFT FREQUENCY BARS" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <ListView ItemsSource="{x:Bind ViewModel.Visemes}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:VisemeMetric">
                                    <Grid ColumnSpacing="10" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Viseme}" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource AccentCyberCyanBrush}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Value="{x:Bind Weight}" Maximum="1.0" Height="5" Foreground="{StaticResource StatusEmeraldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind DbLevel}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Photo Mode Presets Shelf -->
            <Border Background="{StaticResource ElevatedCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="12" Padding="18">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE722;" FontSize="15" Foreground="#EC4899" />
                            <TextBlock Text="PHOTO MODE STUDIO &amp; POSES" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.TakePhotoSnapshotCommand}" Style="{ThemeResource AccentButtonStyle}" Height="34">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE722;" FontSize="12" />
                                <TextBlock Text="Capture 4K Snapshot" FontWeight="Bold" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <GridView ItemsSource="{x:Bind ViewModel.PhotoPresets}" SelectionMode="Single">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="core:PhotoModePreset">
                                <Button
                                    Command="{Binding Path=DataContext.SelectPhotoPresetCommand, ElementName=ThisPage}"
                                    CommandParameter="{Binding}"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <Border Background="{StaticResource StageTerminalBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Width="240">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="#164E63" CornerRadius="3" Padding="5,1">
                                                    <TextBlock Text="{x:Bind LightingPreset}" FontSize="9" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanGlowBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Pose}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
