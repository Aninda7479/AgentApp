<Page
    x:Class="SuperAgent.Views.CompanionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20">
        <StackPanel MaxWidth="1100" Spacing="20">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Companion &amp; 3D Pet Ecosystem" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="VRM 3D humanoid partner, procedural lip-sync, mood journal, and floating desktop pet." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.ToggleFloatingPetCommand}" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE737;" FontSize="14" />
                        <TextBlock Text="Pop Out Desktop Pet" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Main Stage: 3D Avatar Viewport + Partner Inspector -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: 3D VRM Companion Canvas -->
                <Border Grid.Column="0" Background="#0B132B" BorderThickness="1" BorderBrush="#1C2541" CornerRadius="12" Padding="20" Height="420">
                    <Grid>
                        <!-- Simulated 3D Avatar Canvas -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                            <Border Width="140" Height="140" CornerRadius="70" Background="#1E1B4B" BorderThickness="3" BorderBrush="#8B5CF6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE76E;" FontSize="64" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.CompanionName, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Border CornerRadius="4" Padding="8,3" Background="#064E3B">
                                    <TextBlock Text="Active Mood: Joy" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7" />
                                </Border>
                                <Border CornerRadius="4" Padding="8,3" Background="#1E293B">
                                    <TextBlock Text="VRM 1.0 Rigged" FontSize="11" Foreground="#94A3B8" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center" FontStyle="Italic" />
                        </StackPanel>

                        <!-- Floating Intimacy & Battery Gauges -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#1E293B" CornerRadius="8" Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEB51;" FontSize="12" Foreground="#EC4899" />
                                    <TextBlock Text="{x:Bind ViewModel.IntimacyLevel, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE83F;" FontSize="12" Foreground="#10B981" />
                                    <TextBlock Text="{x:Bind ViewModel.BatteryLevel, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: Emotion Badges & Audio Viseme Meter -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="16">
                        <!-- Mood Reaction Badges -->
                        <TextBlock Text="Emotion &amp; Mood Badges" FontWeight="SemiBold" FontSize="14" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Moods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:CompanionMoodBadge">
                                    <Border Margin="0,0,0,6" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="#1E1B4B" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="12" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Mood}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Audio Viseme Lip-Sync Meter -->
                        <TextBlock Text="Audio Viseme Lip-Sync Meter" FontWeight="SemiBold" FontSize="14" />
                        <ListView ItemsSource="{x:Bind ViewModel.Visemes}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:VisemeMetric">
                                    <Grid ColumnSpacing="10" Padding="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Viseme}" FontWeight="Bold" FontSize="11" FontFamily="Consolas" Foreground="#06B6D4" />
                                        <ProgressBar Grid.Column="1" Value="{x:Bind Weight}" Maximum="1.0" Height="4" Foreground="#10B981" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind DbLevel}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Photo Mode Presets Shelf -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE722;" FontSize="14" Foreground="#EC4899" />
                            <TextBlock Text="Photo Mode Studio &amp; Poses" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.TakePhotoSnapshotCommand}" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE722;" FontSize="12" />
                                <TextBlock Text="Capture 4K Snapshot" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <GridView ItemsSource="{x:Bind ViewModel.PhotoPresets}" SelectionMode="Single">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="core:PhotoModePreset">
                                <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" Padding="12" Width="220">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{x:Bind LightingPreset}" FontSize="10" Foreground="#06B6D4" />
                                        <TextBlock Text="{x:Bind Pose}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
