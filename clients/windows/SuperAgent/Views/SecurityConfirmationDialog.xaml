<ContentDialog
    x:Class="SuperAgent.Views.SecurityConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d"
    Title="Security Confirmation &amp; LockScreen Guardian"
    PrimaryButtonText="Authorize &amp; Continue"
    SecondaryButtonText="Block Action"
    CloseButtonText="Dismiss"
    DefaultButton="Primary">

    <Grid MaxWidth="640" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- LockScreen Guardian Shield Banner -->
        <Border Grid.Row="0" Background="#1E1B4B" BorderThickness="1" BorderBrush="#6366F1" CornerRadius="8" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xEA18;" FontSize="24" Foreground="#818CF8" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ShieldStatus, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" Foreground="#EEF2FF" />
                    <TextBlock Text="Hardware-enforced scrypt key storage + zero-leak sandbox" FontSize="11" Foreground="#C7D2FE" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsLockScreenArmed, Mode=TwoWay}" OnContent="Armed" OffContent="Disarmed" />
            </Grid>
        </Border>

        <!-- 4-Tier Confirmation Matrix -->
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="4-Tier Confirmation Governance" FontWeight="SemiBold" FontSize="14" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="0" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Tier 0" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="Hand-Off" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="1" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Tier 1" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="Always Confirm" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="2" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Tier 2" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="Pre-Approval" FontSize="10" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Command="{x:Bind ViewModel.SetTierCommand}" CommandParameter="3" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Tier 3" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="Autonomous" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- 16-State zo Decision Badges View -->
        <StackPanel Grid.Row="2" Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="zo Security Decision Badges (16-State Policy)" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Grid.Column="1" Text="Rule zo-04 Active" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
            </Grid>
            <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" Padding="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Badges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:ZoSecurityDecisionBadge">
                                <Border CornerRadius="4" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" />
                                        <TextBlock Text="{x:Bind Label}" FontSize="10" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Credential Vault 7-Branch Recovery Actions -->
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="Credential Vault 7-Branch Recovery Protocols" FontWeight="SemiBold" FontSize="14" />
            <ListView ItemsSource="{x:Bind ViewModel.RecoveryBranches}" SelectedItem="{x:Bind ViewModel.SelectedBranch, Mode=TwoWay}" SelectionMode="Single" MaxHeight="180">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:CredentialRecoveryBranch">
                        <Grid Padding="4,4" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Padding="4,2" Background="{ThemeResource LayerFillColorAltBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind BranchId}" FontSize="10" FontWeight="Bold" Foreground="#8B5CF6" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind ActionName}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{x:Bind ProtocolSummary}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind RiskRating}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</ContentDialog>
