<Page
    x:Class="SuperAgent.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SuperAgent.ViewModels"
    xmlns:core="using:SuperAgent.Core"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20">
        <StackPanel MaxWidth="1100" Spacing="20">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Tasks &amp; Scheduled Routines" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="4-column autonomous agent Kanban board, cron routines with Telegram alerts, and webhook triggers." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" FontSize="12" FontWeight="Medium" />
                </Border>
            </Grid>

            <!-- Quick Add Task Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="10" Padding="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay}" PlaceholderText="Enter new agent task (e.g. Audit dependencies)..." />
                    <ComboBox Grid.Column="1" SelectedValue="{x:Bind ViewModel.NewTaskPersona, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <x:String>Code Janitor</x:String>
                        <x:String>Windows Specialist</x:String>
                        <x:String>Security Guardian</x:String>
                        <x:String>Hardware Co-Pilot</x:String>
                    </ComboBox>
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.AddTaskCommand}" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Add Task" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 4-Column Kanban Board -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Col 1: To Do -->
                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#6366F1" VerticalAlignment="Center" />
                            <TextBlock Text="To Do" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.ToDoCards.Count, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.ToDoCards}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:KanbanCard">
                                    <Border Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3" Padding="4,1" Background="#1E1B4B" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Priority}" FontSize="9" FontWeight="Bold" Foreground="#818CF8" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind AssignedPersona}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Col 2: In Progress -->
                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#06B6D4" VerticalAlignment="Center" />
                            <TextBlock Text="In Progress" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.InProgressCards.Count, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.InProgressCards}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:KanbanCard">
                                    <Border Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3" Padding="4,1" Background="#083344" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Priority}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind AssignedPersona}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Col 3: Blocked / Review -->
                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock Text="Blocked / Review" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.BlockedCards.Count, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.BlockedCards}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:KanbanCard">
                                    <Border Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3" Padding="4,1" Background="#451A03" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Priority}" FontSize="9" FontWeight="Bold" Foreground="#FBBF24" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind AssignedPersona}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Col 4: Done -->
                <Border Grid.Column="3" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" VerticalAlignment="Center" />
                            <TextBlock Text="Done" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.DoneCards.Count, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.DoneCards}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:KanbanCard">
                                    <Border Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3" Padding="4,1" Background="#064E3B" HorizontalAlignment="Left">
                                                    <TextBlock Text="Completed" FontSize="9" FontWeight="Bold" Foreground="#6EE7B7" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind AssignedPersona}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Cron Routines Deck -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="#8B5CF6" />
                        <TextBlock Text="Scheduled Automations &amp; Telegram Routines" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Routines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:CronRoutine">
                                <Border Margin="0,0,0,8" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" Padding="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind PromptTemplate}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <Border CornerRadius="3" Padding="6,2" Background="#1E1B4B">
                                                    <TextBlock Text="{x:Bind CronExpression}" FontSize="10" FontFamily="Consolas" Foreground="#818CF8" />
                                                </Border>
                                                <TextBlock Text="{x:Bind PresetName}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind TelegramChatId}" FontSize="10" Foreground="#06B6D4" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsEnabled}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="Run Now" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
